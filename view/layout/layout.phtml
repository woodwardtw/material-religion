<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$siteTitle = $site->title();
$browseBodyTruncation = ($this->themeSetting('browse_body_truncation')) ? $this->themeSetting('browse_body_truncation') : 'fade';
$banner = $this->themeSettingAssetUrl('banner');
$this->htmlElement('html')->setAttribute('lang', $this->lang());
$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName('viewport', 'width=device-width, initial-scale=1');
$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append($this->setting('installation_title', 'Omeka S'));
$this->headLink()->prependStylesheet($this->assetUrl('css/style.css'));
$this->headLink()->prependStylesheet($this->assetUrl('css/iconfonts.css', 'Omeka'));
$this->headLink()->prependStylesheet('https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;1,400&display=swap');
$this->headScript()->prependFile($this->assetUrl('js/default.js'));
$this->headScript()->prependFile($this->assetUrl('js/global.js', 'Omeka'));
$this->headScript()->prependFile($this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka'));
$this->jsTranslate();
$this->htmlElement('body')->appendAttribute('class', 'body-truncate-' . $browseBodyTruncation);
$this->trigger('view.layout');
$userBar = $this->userBar();
?>
<?php echo $this->doctype(); ?>
<?php echo $this->htmlElement('html'); ?>
    <head>
        <?php echo $this->headMeta(); ?>
        <?php echo $this->headTitle(); ?>
        <?php echo $this->headLink(); ?>
        <?php echo $this->headStyle(); ?>
        <?php echo $this->headScript(); ?>
        <?php echo $this->partial('common/theme-config'); ?>
    </head>

    <?php echo $this->htmlElement('body'); ?>
        <a id="skipnav" href="#content"><?php echo $this->translate('Skip to main content'); ?></a>
        <?php echo $userBar; ?>
        <header>
            <div class="site-title-bar">
                <div class="site-title-inner">
                    <h1 class="site-title">
                        <a href="<?php echo $site->url(); ?>">
                        <?php // Admin "Logo" theme setting overrides the bundled knock-out logo (393x160, 2x for an 80px header logo). ?>
                        <img src="<?php echo $escape($this->themeSetting('logo') ? $this->themeSettingAssetUrl('logo') : $this->assetUrl('img/materialrel-logo.png')); ?>" alt="<?php echo $escape($translate('Material Religions, Princeton University')); ?>" width="197" height="80" />
                        <span class="site-name"><?php echo $escape($siteTitle); ?></span>
                        </a>
                    </h1>
                </div>
            </div>
            <nav id="top-nav">
                <button type="button" id="mobile-nav-toggle" aria-expanded="false" aria-label="<?php echo $translate('Toggle Menu'); ?>" title="<?php echo $translate('Toggle Menu'); ?>" aria-expanded="false"></button>
                <?php
                echo $site->publicNav()->menu()->renderMenu(null, [
                    'maxDepth' => $this->themeSetting('nav_depth') - 1,
                    'id' => 'top-nav-contents'
                ]);
                ?>
            </nav>
            <div id="search">
                <?php echo $this->partial('common/search-overlay'); ?>
            </div>
            <?php if ($banner): ?>
            <div class="banner">
                <img role="presentation" src="<?php echo $this->themeSettingAssetUrl('banner'); ?>" title="Banner">
            </div>
            <?php endif; ?>
        </header>
        <div id="content" role="main">
            <?php echo $this->content; ?>
        </div>
        <footer>
            <?php
            $footerColumns = [
                // Fall back to the legacy single "footer" setting for the left column.
                'left' => $this->themeSetting('footer_left', $this->themeSetting('footer')),
                'middle' => $this->themeSetting('footer_middle'),
                'right' => $this->themeSetting('footer_right'),
            ];
            // Let footer HTML reference theme images as "../img/file.png" (or "img/file.png").
            $themeImagePaths = function ($html) {
                if (!$html) {
                    return $html;
                }
                return preg_replace_callback(
                    '#(src|href)=(["\'])(?:\.\./|\./)?img/([^"\']+)\2#i',
                    function ($m) {
                        return $m[1] . '=' . $m[2] . $this->escapeHtmlAttr($this->assetUrl('img/' . $m[3])) . $m[2];
                    },
                    $html
                );
            };
            $footerColumns = array_map($themeImagePaths, $footerColumns);
            $footerBottomContent = $themeImagePaths($this->themeSetting('footer_bottom'));
            $hasFooterContent = (bool) array_filter($footerColumns);
            ?>
            <div class="footer-inner footer-columns">
                <?php if ($hasFooterContent): ?>
                    <?php foreach ($footerColumns as $position => $columnContent): ?>
                    <div class="footer-column footer-<?php echo $position; ?>">
                        <?php echo $columnContent; ?>
                    </div>
                    <?php endforeach; ?>
                <?php else: ?>
                    <div class="footer-column footer-left">
                        <?php echo $this->translate('Powered by Omeka S'); ?>
                    </div>
                <?php endif; ?>
            </div>
            <?php if ($footerBottomContent): ?>
            <div class="footer-bottom">
                <div class="footer-inner">
                    <?php echo $footerBottomContent; ?>
                </div>
            </div>
            <?php endif; ?>
        </footer>
    </body>
</html>
